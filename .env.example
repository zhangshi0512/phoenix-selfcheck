# SelfCheck Agent - Environment Variables
# Copy this file to .env and fill in your values

# --- Required ---

# Gemini API key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Alias for @google/genai SDK
GOOGLE_API_KEY=your-google-api-key

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# --- Arize Phoenix (local; no API key) ---
# Start Phoenix: pip install arize-phoenix && phoenix serve  →  http://localhost:6006
ARIZE_ENDPOINT=http://localhost:6006
ARIZE_PROJECT_ID=default
ARIZE_API_KEY=
# For Phoenix Cloud instead, set ARIZE_ENDPOINT=https://app.phoenix.arize.com and your API key.

# --- Security ---
WEBHOOK_API_KEY=your-webhook-auth-key

# --- Server ---
PORT=8080
NODE_ENV=development

# --- Optional ---
GEMINI_MODEL=gemini-2.5-flash
FUNCTION_REGION=us-central1
ALERT_CHANNELS=
